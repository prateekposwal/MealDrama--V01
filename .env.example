# ─────────────────────────────────────────────────────────────────────────────
# MealDrama Environment Configuration
# Prefix: VITE_ = client-side (bundled by Vite, visible in browser)
# Unprefixed = server-side only (used by scripts/CI)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Required ────────────────────────────────────────────────────────────────
# Base URL for the MealDrama backend API.
# In dev: leave blank or comment out → falls back to Vite proxy (localhost:3001)
# In production: set to your deployed backend URL
VITE_API_URL=https://api.mealdrama.example.com/api/v1

# ─── Node Environment ───────────────────────────────────────────────────────
# Set by the deployment platform automatically. Only override in local dev.
NODE_ENV=development

# ─── Feature Flags (Optional) ────────────────────────────────────────────────
# Enable AI-powered smart suggestions (uses MealDrama's built-in engine)
VITE_ENABLE_SMART_SUGGESTIONS=false

# Enable automated meal loop rotation (default: true)
VITE_ENABLE_MEAL_LOOP=true

# ─── Development (Optional ──────────────────────────────────────────────────
# Vite dev server port (default: 3000)
# VITE_DEV_PORT=3000

# ─── Server Auth / OAuth (server/.env — read by server/src/routes/oauth.ts) ──
# Google OAuth 2.0 client — https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# JWT signing secret (REQUIRED in production; local dev falls back to a
# non-production dev secret when absent)
# JWT_SECRET=change-me
# JWT_EXPIRY=7d
# Public origin the SPA redirects to after the Google web OAuth callback
# FRONTEND_URL=http://localhost:3001
# Server's own public base URL — builds the absolute OAuth callbackURL
# SERVER_BASE_URL=http://localhost:3001
# Comma-separated allowed CORS origins (default: reflect any origin)
# CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# ─── Cook WhatsApp channel (server/.env + Render) ────────────────────────────
# The cook's ONLY channel is WhatsApp Business Cloud API. Absent these values
# the whole pipeline runs in DRY-RUN: the daily scheduler and every outbound/
# inbound send LOG the composed messages and never touch the network. Set them
# to flip to real sends (Phase 2). See docs/WHATSAPP_COOK_PLAN.md.
# System-user token — developers.facebook.com → WhatsApp → API Setup
# WHATSAPP_TOKEN=EAAG...
# The WhatsApp Business phone number ID (not the display number)
# WHATSAPP_PHONE_ID=123456789
# App secret for webhook X-Hub-Signature-256 verification (never commit)
# WHATSAPP_APP_SECRET=
# Webhook verify token (GET challenge handshake)
# WHATSAPP_VERIFY_TOKEN=wh_cook_verify
# Graph version / endpoint override (defaults: v20.0, graph.facebook.com)
# WHATSAPP_GRAPH_VERSION=v20.0
# WHATSAPP_GRAPH_BASE=https://graph.facebook.com
