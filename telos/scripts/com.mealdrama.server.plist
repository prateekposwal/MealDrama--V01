<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mealdrama.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/prateekposwal/MD-App/telos/scripts/watchdrama.sh</string>
    </array>

    <!-- Auto-start at login / reboot -->
    <key>RunAtLoad</key>
    <true/>

    <!-- launchd IS the supervisor: restart the process once it exits.
         The script execs the server in the foreground, so launchd tracks the
         real server pid; no background child teardown, no StartInterval races. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/mealdrama_watchdog.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mealdrama_watchdog.err.log</string>
</dict>
</plist>