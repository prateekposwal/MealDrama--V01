generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  connection_timeout = 20
}

// 1. AUTH & IDENTITY
model User {
  id                 String   @id @default(uuid())
  email              String?  @unique // Google Auth
  phone              String?  @unique // OTP Auth
  name               String?
  googleId           String?  @unique
  systemId           String?  @unique // e.g., USER-8821
  createdAt          DateTime @default(now())
  onboardingComplete Boolean  @default(false)

  // Relations
  profile          UserProfile?
  plans            UserPlan[]
  completedSlots   CompletedSlot[]
  householdMembers HouseholdMember[]
  traySlots        TraySlot[]
  customDishes     CustomDish[]
  loopConfig       LoopConfig?
}

// 2. HOUSEHOLD
model Household {
  id             String   @id @default(uuid())
  name           String
  code           String   @unique @default(uuid())
  locationRegion String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  members    HouseholdMember[]
  expenses   Expense[]
  activities ActivityFeed[]

  @@index([code])
}

model HouseholdMember {
  id          String   @id @default(uuid())
  householdId String
  userId      String?
  name        String
  role        String   @default("member") // admin, member
  createdAt   DateTime @default(now())

  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  expenseSplits ExpenseSplit[]

  @@index([householdId])
  @@index([userId])
}

/// Tracks household shared expenses (cook salary, groceries) for roommates
model Expense {
  id          String   @id @default(uuid())
  householdId String
  addedBy     String // userId of who added this
  title       String // "Cook Ramesh - July Salary", "Grocery run"
  amount      Float
  category    String // cook_salary, groceries, utilities, supplies, other
  splitType   String   @default("equal") // equal, custom
  date        DateTime @default(now())
  settled     Boolean  @default(false)
  createdAt   DateTime @default(now())

  household Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  splits    ExpenseSplit[]

  @@index([householdId])
}

model ExpenseSplit {
  id        String  @id @default(uuid())
  expenseId String
  memberId  String // HouseholdMember.id
  amount    Float // this member's share
  paid      Boolean @default(false)

  expense Expense         @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member  HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

/// Activity log for household meal changes
model ActivityFeed {
  id          String   @id @default(uuid())
  householdId String
  memberName  String // display name of who did it
  action      String // "added", "swapped", "removed", "completed"
  detail      String // "Paneer Butter Masala → lunch"
  date        DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId])
}

// 5. USER PREFERENCES
model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  dietType      String   @default("veg") // veg, non-veg, eggitarian, vegan
  region        String   @default("north")
  allergies     String[] // ["peanuts", "gluten"]
  dislikedItems String[] // ["okra", "bitter-gourd"]
  spiceLevel    String   @default("medium") // mild, medium, hot

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 4. MASTER MEAL CATALOG
model Meal {
  id       String   @id // e.g., "north-rajma-chawal"
  name     String
  icon     String?
  category String // breakfast, lunch, dinner, snacks
  type     String // veg, non-veg, eggitarian, vegan
  region   String?
  tags     String[] // ["high-protein", "winter-special"]

  variants    MealVariant[]
  ingredients MealIngredient[] // The master recipe
  userPlans   UserPlan[]
  trayItems   TrayItem[]

  @@index([category, type])
  @@index([tags])
}

model MealVariant {
  id             String   @id
  mealId         String
  name           String
  cookingStyle   String?
  baseStyle      String?
  addOn          String?
  accompaniments String[]
  mealContext    String?
  regionOverride String?

  meal  Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  plans UserPlan[]
}

// 6. INGREDIENT STANDARDIZATION
model Ingredient {
  id          String   @id // e.g., "onion-red"
  name        String // "Red Onion"
  category    String // produce, grains, dairy, spices, pantry, proteins
  defaultUnit String // g, kg, pcs, tbsp, cup
  aliases     String[] // ["pyaz", "onion"]

  usedIn MealIngredient[]
}

model MealIngredient {
  id            String  @id @default(uuid())
  mealId        String
  ingredientId  String
  qtyPerServing Float
  unit          String // Override default if needed
  notes         String? // "Optional: for garnish"

  meal       Meal       @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([mealId, ingredientId])
}

// USER PLANS & COMPLETION
model UserPlan {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  slot      String // breakfast, lunch, dinner, snacks
  mealId    String
  variantId String?
  qty       Int      @default(1)
  status    String   @default("planned") // planned, swapped, skipped
  version   Int      @default(0) // optimistic locking - increment on every write

  user      User         @relation(fields: [userId], references: [id])
  meal      Meal         @relation(fields: [mealId], references: [id])
  variant   MealVariant? @relation(fields: [variantId], references: [id])
  updatedAt DateTime     @updatedAt

  @@unique([userId, date, slot])
  @@index([userId])
  @@index([userId, date])
  @@index([mealId])
}

model CompletedSlot {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime @db.Date
  slot        String
  status      String   @default("cooked") // cooked, missed, skipped
  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date, slot])
  @@index([userId])
  @@index([userId, date])
}

// TRAY BUILDER 2.0
model TraySlot {
  id            String   @id @default(uuid())
  userId        String
  date          DateTime @db.Date
  slot          String // breakfast, lunch, snacks, dinner
  totalServings Int      @default(1)
  guestCount    Int      @default(0)
  guestDays     Int      @default(0)
  isGuestMode   Boolean  @default(false)
  version       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items TrayItem[]

  @@unique([userId, date, slot])
  @@index([userId, date])
  @@index([userId])
}

model TrayItem {
  id           String   @id @default(uuid())
  traySlotId   String
  mealId       String?
  customDishId String?
  quantity     Int      @default(1)
  gravyStyle   String   @default("Default")
  rotiType     String   @default("Phulka")
  riceType     String   @default("Plain")
  sides        String[]
  beverages    String[]
  requestedBy  String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  traySlot   TraySlot    @relation(fields: [traySlotId], references: [id], onDelete: Cascade)
  meal       Meal?       @relation(fields: [mealId], references: [id], onDelete: SetNull)
  customDish CustomDish? @relation(fields: [customDishId], references: [id], onDelete: SetNull)

  @@index([traySlotId])
  @@index([mealId])
  @@index([customDishId])
}

model CustomDish {
  id           String   @id @default(uuid())
  userId       String
  name         String
  category     String // breakfast, lunch, snacks, dinner
  dietType     String   @default("veg")
  isCustom     Boolean  @default(true)
  defaultGravy String   @default("Default")
  defaultRoti  String   @default("Phulka")
  defaultRice  String   @default("Plain")
  prepMinutes  Int      @default(30)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredients CustomDishIngredient[]
  trayItems   TrayItem[]

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, category])
}

model CustomDishIngredient {
  id           String  @id @default(uuid())
  customDishId String
  name         String
  quantity     Float
  unit         String
  isOptional   Boolean @default(false)
  notes        String?

  customDish CustomDish @relation(fields: [customDishId], references: [id], onDelete: Cascade)

  @@index([customDishId])
}

model LoopConfig {
  id             String   @id @default(uuid())
  userId         String   @unique
  cycleLength    Int      @default(7)
  startDate      String
  skipDays       Int[]
  repeatPattern  String   @default("sequential")
  insertStrategy String   @default("append")
  sourceDishIds  String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
